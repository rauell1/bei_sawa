# Full challenge mode uses local open-weights Qwen 2.5 through Ollama.
BEISAWA_LLM_MODE=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional runtime locations; defaults are under ./var.
# BEISAWA_RUNTIME_DIR=./var
# MCP_FILESYSTEM_COMMAND=./node_modules/.bin/mcp-server-filesystem
