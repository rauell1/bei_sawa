# Full challenge mode uses local open-weights Qwen 2.5 through Ollama.
BEISAWA_LLM_MODE=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional runtime locations; defaults are under ./var.
# BEISAWA_RUNTIME_DIR=./var
# MCP_FILESYSTEM_COMMAND=./node_modules/.bin/mcp-server-filesystem

# Hosted Python engine: require Neon JWTs; URLs come from your Neon branch.
# BEISAWA_ENGINE_REQUIRE_AUTH=1
# NEON_AUTH_BASE_URL=https://your-branch-auth-host/neondb/auth
# NEON_AUTH_JWKS_URL=https://your-branch-auth-host/neondb/auth/jwks

# Set before Neon plan/deploy. The Function calls this HTTPS Python origin.
# BEISAWA_ENGINE_URL=https://your-deployed-python-engine
